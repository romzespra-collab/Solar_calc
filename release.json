  "programs": [
    {
      "name": "solar_calc",
      "dir": "",
      "files": [
        ["solar_calc.py", "VERSION = \"{v}\""],
        ["solar_calc.py", "solar_calc.py  v{v}"],
        ["README.md", "(solar_calc) v{v}"],
        ["solar_calc.spec", "solar_calc.spec  v{v}"]
      ],
      "headers": true,
      "headers_skip": ["build_exe.bat"],
      "changelog": {"file": "solar_calc.py", "after": "re:^Журнал:$", "template": "v{v}: {msg}\n",
                    "wrap": 112, "keep": 10, "entry": "re:^v\\d+\\.\\d+\\.\\d+:", "tail": "Более ранние версии"},
      "allow_in_zip": []
    }
  ]
}
